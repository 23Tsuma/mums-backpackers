# Gmail SMTP. Use a Google App Password in .env.local, not the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=festusleonard996@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=Mums Backpackers
SMTP_FROM_EMAIL=festusleonard996@gmail.com

# Local XAMPP MariaDB. Use a separate database user and password in .env.local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mumsbackpackers_db
DB_USER=mumsback_app
DB_PASSWORD=change-me
DB_SSL=false

# Existing owner/property management still uses Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase service role key for durable property image uploads. Never use NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=

# Use separate, randomly generated secrets (at least 32 characters).
BOOKING_RATE_LIMIT_SECRET=
BOOKING_RETRY_SECRET=

# One-time, private setup token for creating the first /admin account (32+ characters).
ADMIN_SETUP_TOKEN=
